---
const currentYear = new Date().getFullYear()

const LINKS = [
  {
    label: "Computrabajo",
    href: "https://www.computrabajo.com.co/",
  },
  {
    label: "El Empleo",
    href: "https://www.elempleo.com/co",
  },
  {
    label: "OLX Colombia",
    href: "https://www.olx.com.co/",
  },
  {
    label: "Fincaraíz",
    href: "https://www.fincaraiz.com.co/",
  },
  {
    label: "TuCarros",
    href: "https://www.tucarros.com/",
  },
  {
    label: "Mercado Libre Colombia",
    href: "https://www.mercadolibre.com.co/",
  },
]
---

<div class="flex flex-col items-center px-10">
  <ul
    class="hidden md:inline-flex gap-x-4 gap-y-4 flex-wrap justify-center text-sm w-full pb-10 underline-offset-[3px]"
  >
    <li>
      <span>InfoTrabajo Colombia es partner de </span>
    </li>

    {
      LINKS.map(({ label, href }, index: number) => (
        <li
          class={`${index !== LINKS.length - 1 && "after:content-['|'] after:ml-4"} text-center`}
        >
          <a
            class="hover:underline"
            href={href}
            target="_blank"
            aria-label={`Visita ${label}`}
          >
            {label}
          </a>
        </li>
      ))
    }

    <li class="text-center">
      <span>© {currentYear}</span>
    </li>
  </ul>
</div>